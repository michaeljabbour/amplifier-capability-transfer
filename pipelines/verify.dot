// HGT — Loop 1: BLIND VERIFICATION (outer loop; runs after transfer loops land rows).
//
// For each ledger row in state `implemented`, a verifier that is BLIND to every
// builder artifact independently derives acceptance checks from the DONOR (the
// executable ground truth) and validates the host(s). Pass -> terminal state
// `verified`. Fail -> findings recorded; the row reopens ONCE (implemented -> new,
// requiring owner-directed recovery of the existing build branch), then `acknowledged`.
//
// WHY: the transfer loop authors the very tests/probe it must pass (self-grading).
// Deterministic execution is not independence — independence is about who WRITES
// the rubric. This loop is the independent rubric-writer. Verifier -> builder info
// flow is allowed (.ai/verify_findings/); builder -> verifier is forbidden.
//
// ENGINE: attractor loop-pipeline (same contract as hgt.dot: routing on last stdout
// line, `... && printf pass || printf fail` idiom is load-bearing, env-var params).
//   DONOR_PATH   abs path to the donor (ground truth; read+observe only)
//   HOST_A_PATH  abs path to host A (LEDGER_FILE + pipelines/ledger.py live here)
//   HOST_B_PATH  abs path to host B (checked when the row's target is ab|split)
//   FORGE_TOOL   abs path to amplifier-skill-forge/tools/forge.py
//   LEDGER_FILE  ledger path relative to HOST_A_PATH
//
// MODELS: claude-opus-4-8 on LLM nodes.

digraph hgt_verify {
    graph [
        goal="Loop 1 — blind verification. For each ledger row in state 'implemented', independently confirm the host(s) exhibit the DONOR's behavior for that capability. Derive your own checks from the donor (executable ground truth). NEVER read builder artifacts (.ai/hgt_*), host tests, or capability cards — independence is the point. Pass -> 'verified' (terminal). Fail -> findings, reopen once (-> new), then 'acknowledged'. Never edit donor or host source. Reopened rows require owner-directed branch recovery; never reset, delete or take over an existing build branch automatically.",
        default_fidelity="truncate",
        default_max_retry="3"
    ]

    start [shape=Mdiamond]

    CheckQueue [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' verify_queue) || exit 1; cd -- \"$HOST_A_PATH\" || exit 1; actual=$(LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py earliest-implemented) || exit 1; test \"$actual\" = \"$selection\" || exit 1; if test \"$selection\" = NONE; then printf done; else printf process; fi ); then :; else printf blocked; fi"]

    SelectRow [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' verify_queue) || exit 1; cd -- \"$HOST_A_PATH\" || exit 1; actual=$(LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py earliest-implemented) || exit 1; test \"$actual\" = \"$selection\" || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); mkdir -p .ai/verify_checks .ai/verify_findings || exit 1; printf \"SLUG=%s\\nTARGET=%s\\n\" \"$SLUG\" \"$TARGET\" > .ai/verify_current.env || exit 1; printf ready ); then :; else printf blocked; fi"]

    DeriveChecks [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="You are the BLIND VERIFIER. Read $HOST_A_PATH/.ai/verify_current.env for SLUG and TARGET. GROUND TRUTH ONLY: study the capability named SLUG in the donor at $DONOR_PATH — read its code and boot it via $FORGE_TOOL to observe the REAL behavior. FORBIDDEN (your independence is the point): reading any .ai/hgt_* builder artifact, any tests/ in the host repo(s), or pipelines/*-capabilities.md. Derive YOUR OWN acceptance checks from the donor's observable behavior and write $HOST_A_PATH/.ai/verify_checks/$SLUG.sh: a bash script using $FORGE_TOOL (env $FORGE) that boots the REAL host app at $HOST_A_PATH (and $HOST_B_PATH too when TARGET is ab or split) and asserts the donor-equivalent behavior from screen/grep; exit 0 iff it holds. Observe the HOST only through the terminal — do not read host implementation source (read code on the donor side only). Write nothing outside .ai/verify_checks/. $goal"]

    RunChecks [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' verify_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); test -f \".ai/verify_checks/$SLUG.sh\" || exit 1; mkdir -p .ai/verify_logs || exit 1; export FORGE=\"$FORGE_TOOL\"; exec 3>\".ai/verify_logs/$SLUG.doctor.log\" || exit 1; exec 4>\".ai/verify_logs/$SLUG.checks.log\" || exit 1; if python3 \"$FORGE\" doctor >&3 2>&1 && bash \".ai/verify_checks/$SLUG.sh\" >&4 2>&1; then printf pass; else printf fail; fi ); then :; else printf blocked; fi"]

    MarkVerified [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' verify_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py update \"$SLUG\" verified >/dev/null || exit 1; printf next ); then :; else printf blocked; fi"]

    RecordFindings [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Your verification checks failed. Read $HOST_A_PATH/.ai/verify_logs/$SLUG.checks.log, $HOST_A_PATH/.ai/verify_logs/$SLUG.doctor.log and your own script $HOST_A_PATH/.ai/verify_checks/$SLUG.sh (SLUG from .ai/verify_current.env). Write $HOST_A_PATH/.ai/verify_findings/$SLUG.md: what the donor does, what the host does instead, and the exact failing assertion. FIRST LINE must be exactly FLAKE if the ONLY failure is a forge timing/screen-scrape artifact, otherwise exactly DEFECT. Do not edit code or your checks. $goal"]

    ReopenGate [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' verify_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); test -f \".ai/verify_findings/$SLUG.md\" || exit 1; finding=$(head -n 1 \".ai/verify_findings/$SLUG.md\") || exit 1; case \"$finding\" in FLAKE|DEFECT) :;; *) exit 1;; esac; if test \"$finding\" = FLAKE && ! test -f \".ai/verify_flake_$SLUG\"; then (set -C; : >\".ai/verify_flake_$SLUG\") || exit 1; printf recheck; elif test -f \".ai/verify_reopened_$SLUG\"; then LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py update \"$SLUG\" acknowledged >/dev/null || exit 1; printf next; else (set -C; : >\".ai/verify_reopened_$SLUG\") || exit 1; LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py update \"$SLUG\" new >/dev/null || exit 1; printf next; fi ); then :; else printf blocked; fi"]

    // Invalid state or helper failures stop; they are not verification results.
    CheckQueue -> exit [condition="context.tool.last_line=blocked"]
    SelectRow -> exit [condition="context.tool.last_line=blocked"]
    RunChecks -> exit [condition="context.tool.last_line=blocked"]
    MarkVerified -> exit [condition="context.tool.last_line=blocked"]
    ReopenGate -> exit [condition="context.tool.last_line=blocked"]

    exit [shape=Msquare]

    start -> CheckQueue
    CheckQueue -> exit      [condition="context.tool.last_line=done"]
    CheckQueue -> SelectRow [condition="context.tool.last_line=process"]
    SelectRow -> DeriveChecks [condition="context.tool.last_line=ready"]
    DeriveChecks -> RunChecks
    RunChecks -> MarkVerified   [condition="context.tool.last_line=pass"]
    RunChecks -> RecordFindings [condition="context.tool.last_line=fail"]
    RecordFindings -> ReopenGate
    ReopenGate -> RunChecks    [condition="context.tool.last_line=recheck"]
    ReopenGate -> CheckQueue   [condition="context.tool.last_line=next", loop_restart="true"]
    MarkVerified -> CheckQueue [condition="context.tool.last_line=next", loop_restart="true"]
}
