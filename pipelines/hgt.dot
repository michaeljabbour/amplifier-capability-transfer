// HGT — the Horizontal Gene-Transfer attractor (archetype graph).
//
// Transfers ONE capability per loop from a donor repo (any language) into one or
// two host repos, RE-EXPRESSED through each host's own seams — never a code graft.
// Gated by the host's unit suite AND a real-terminal forge check before a PR opens.
//
// ENGINE: attractor loop-pipeline. `box` = LLM agent; `parallelogram` = deterministic
// tool node routed on its LAST printed stdout line (context.tool.last_line, matched
// by EXACT string equality; stderr ignored; non-zero exit leaves last_line STALE —
// which is why every gate ends `... && printf pass || printf fail`, never remove it).
//
// PARAMETERS reach tool nodes as UPPERCASE SHELL ENV VARS (fail-loud). Export them
// before launch, OR pass identically-named params via run_pipeline (which seeds them
// as flat context keys). Do NOT rely on a mounted orchestrator's `config.params` for
// tool_command substitution — that path reaches prompts only, not tool_command
// (engine limitation; see docs/DESIGN_DECISIONS.md).
//   DONOR_PATH     abs path to the donor repo (READ-ONLY)
//   HOST_A_PATH    abs path to host A (the primary/backend host)
//   HOST_A_KIND    python | rust | new:<lang>   (selects host A's gate stack)
//   HOST_B_PATH    abs path to host B (only for TARGET in {ab,split})
//   HOST_B_KIND    python | rust | new:<lang>
//   FORGE_TOOL     abs path to amplifier-skill-forge/tools/forge.py
//   LEDGER_FILE    ledger path relative to HOST_A_PATH (e.g. pipelines/hgt-ledger.tsv)
//   SCOPE          free-text scope statement (what transfers; exclusions)
//
// LEDGER row = <slug>\t<target>\t<state>. target in {a, ab, split}:
//   a     — host A only (a second host, if any, gets it free over A's protocol)
//   ab    — pure client-side capability: BOTH hosts, each with its own tests/goldens
//   split — host-A backend/protocol FIRST, then client in both (seed as two ordered
//           rows: <slug>-backend (a), then <slug>-client (ab))
// state in {new, implemented, acknowledged}. Keyed by capability SLUG.
//
// MODELS: claude-opus-4-8 on every LLM node (fable-5 refuses autonomous porting).

digraph hgt {
    graph [
        goal="Re-express each capability in the ledger through the host's OWN seams. NEVER import, vendor, or copy donor source (document the behavioral contract; the donor may be any language). Obey each host's conventions and layering. Gate every transfer on the host unit suite AND a real-terminal forge check. One ledger row per loop; one PR per host; never commit to a protected branch. Done when no 'new' rows remain.",
        default_fidelity="truncate",
        default_max_retry="3"
    ]

    start [shape=Mdiamond]

    // --- loop head: params present? any work left? (deterministic, fail-loud) ---
    CheckLedger [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_queue) || exit 1; cd -- \"$HOST_A_PATH\" || exit 1; actual=$(LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py earliest) || exit 1; test \"$actual\" = \"$selection\" || exit 1; if test \"$selection\" = NONE; then printf done; else mkdir -p .ai || exit 1; printf process; fi ); then :; else printf blocked; fi"]

    // --- pick the earliest 'new' capability; capture slug + target ---
    SelectCapability [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="In $HOST_A_PATH run `LEDGER_FILE=$LEDGER_FILE python3 pipelines/ledger.py earliest` \u2014 it prints '<slug> <target>'. Read the capability's one-line summary and donor pointer for <slug> from the run's capability spec (the ledger's companion doc, e.g. pipelines/*-capabilities.md). Scope for this run: $SCOPE. Write TWO files under $HOST_A_PATH/.ai/: (1) hgt_current.md \u2014 slug, target, a one-paragraph capability summary, the donor pointer VERBATIM; (2) hgt_current.env \u2014 exactly two lines `SLUG=<slug>` and `TARGET=<target>`. Do not delete retry state; BranchSetup resets it after validation. Do not follow symlinked .ai artifacts. $goal"]

    // --- fresh per-capability branch in each targeted host (deterministic) ---
    BranchSetup [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); stash_host(){ python3 -c 'import os,subprocess,sys\nfrom pathlib import Path,PurePosixPath\ntry:\n    operation=sys.argv[1]\n    if operation not in {'\"'\"'add'\"'\"','\"'\"'stash'\"'\"'}: raise ValueError('\"'\"'unknown Git operation'\"'\"')\n    root=Path(sys.argv[2]).resolve(strict=True)\n    primary=Path(os.environ['\"'\"'HOST_A_PATH'\"'\"']).resolve(strict=True)\n    controls={PurePosixPath(os.environ['\"'\"'LEDGER_FILE'\"'\"']).as_posix(),'\"'\"'pipelines/ledger.py'\"'\"'} if root==primary else set()\n    base=['\"'\"'git'\"'\"','\"'\"'--literal-pathspecs'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(root)]\n    inventory=subprocess.run(base+['\"'\"'ls-files'\"'\"','\"'\"'-z'\"'\"','\"'\"'--cached'\"'\"','\"'\"'--others'\"'\"','\"'\"'--exclude-standard'\"'\"'],check=True,capture_output=True).stdout\n    selected=[]\n    for raw in sorted(set(inventory.split(b'\"'\"'\\0'\"'\"'))):\n        if not raw: continue\n        relative=PurePosixPath(os.fsdecode(raw))\n        if relative.as_posix() in controls: continue\n        if any(part in {'\"'\"'.ai'\"'\"','\"'\"'__pycache__'\"'\"'} or part.endswith('\"'\"'.pyc'\"'\"') for part in relative.parts): continue\n        selected.append(raw)\n    if not selected: raise SystemExit(0)\n    payload=b'\"'\"'\\0'\"'\"'.join(selected)+b'\"'\"'\\0'\"'\"'\n    arguments=['\"'\"'add'\"'\"','\"'\"'-A'\"'\"'] if operation=='\"'\"'add'\"'\"' else ['\"'\"'stash'\"'\"','\"'\"'push'\"'\"','\"'\"'-q'\"'\"','\"'\"'--include-untracked'\"'\"']\n    subprocess.run(base+arguments+['\"'\"'--pathspec-from-file=-'\"'\"','\"'\"'--pathspec-file-nul'\"'\"'],input=payload,check=True,capture_output=True)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'controlled Git operation blocked'\"'\"',file=sys.stderr)\n    details=getattr(error,'\"'\"'stderr'\"'\"',b'\"'\"''\"'\"')\n    if details: sys.stderr.buffer.write(details)\n    raise SystemExit(1)\n' stash \"$1\"; }; if git show-ref --verify --quiet \"refs/heads/hgt/$SLUG\"; then exit 1; fi; case \"$TARGET\" in ab|split) if git -C \"$HOST_B_PATH\" show-ref --verify --quiet \"refs/heads/hgt/$SLUG\"; then exit 1; fi;; esac; stash_host \"$HOST_A_PATH\" primary || exit 1; git checkout -q main || exit 1; git pull -q --ff-only || exit 1; git checkout -q -b \"hgt/$SLUG\" || exit 1; case \"$TARGET\" in ab|split) cd -- \"$HOST_B_PATH\" || exit 1; stash_host \"$HOST_B_PATH\" secondary || exit 1; git checkout -q main || exit 1; git pull -q --ff-only || exit 1; git checkout -q -b \"hgt/$SLUG\" || exit 1;; esac; cd -- \"$A_ROOT\" || exit 1; after_selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_state) || exit 1; test \"$after_selection\" = \"$selection\" || exit 1; rm -f .ai/hgt_retries || exit 1; printf ready ); then :; else printf blocked; fi"]

    // --- study the donor WITHOUT copying (behavioral contract only; observe via forge) ---
    LocateDonor [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read $HOST_A_PATH/.ai/hgt_current.md. In the donor at $DONOR_PATH, locate the construct(s) implementing this capability (start from the donor pointer). Record the BEHAVIORAL CONTRACT ONLY \u2014 inputs, outputs, config keys, protocol/wire shape, edge cases, user-facing UX \u2014 in $HOST_A_PATH/.ai/hgt_donor.md. Do NOT copy source; you are documenting the gene, not grafting the organ. State explicitly which parts are backend logic vs pure client render (this decides what lands in host A vs a client). Where UX matters and forge can drive the donor, boot it via $FORGE_TOOL to observe the real behavior live. $goal"]

    // --- design the re-expression per target + author the forge probe FIRST ---
    PlanTransfer [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read .ai/hgt_current.md, .ai/hgt_donor.md, .ai/hgt_current.env (TARGET), and each targeted host's conventions (host A: its AGENTS.md / architecture / decision docs; host B if TARGET in {ab,split}: its migration/parity docs). Design how to re-express this capability through each host's OWN seams \u2014 never importing the donor. Name the exact files to change per host, the native primitives to reuse, and every test/golden to add. For 'split': the host-A backend + any protocol addition FIRST, then the client render. Write the plan to .ai/hgt_plan.md. THEN \u2014 acceptance-first \u2014 author the forge probe to .ai/hgt_forge_check.sh: a bash script using $FORGE_TOOL (env $FORGE) that boots the REAL host-A app and, for TARGET in {ab,split}, the REAL host-B app, and asserts the capability from screen/grep; exit 0 on success, non-zero otherwise. Derive assertions from the donor's user-facing contract \u2014 the probe is the spec. $goal"]

    // --- implement the VERTICAL SLICE (feature + tests + CI parity together) ---
    Implement [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read .ai/hgt_plan.md (including any appended 'Fix N' sections) and .ai/hgt_current.env for TARGET. Implement the VERTICAL SLICE in one pass \u2014 feature + unit tests + forge probe + CI parity together, never build-now-test-later \u2014 with file tools on the current branch(es): host-A changes in $HOST_A_PATH (obey its layering; client-visible behavior through its protocol; pure renderers golden-tested), host-B changes in $HOST_B_PATH when TARGET in {ab,split} (idiomatic client, behavioral-equivalence tests, never force-green). The local gate MUST equal what the host's CI runs. Regenerate goldens if a pure renderer changed. Do NOT run the suites yourself \u2014 the next node does. Append files changed (per host) to .ai/hgt_impl.log. $goal"]

    // --- deterministic gate 1: host unit suites, dispatched by kind (== CI) ---
    UnitValidate [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); available_gate(){ case \"$2\" in python) command -v uv >/dev/null;; rust) command -v cargo >/dev/null;; new:*) test -f \"$1/ci/gate.sh\" && test -x \"$1/ci/gate.sh\";; *) return 1;; esac; }; available_gate \"$HOST_A_PATH\" \"$HOST_A_KIND\" || exit 1; case \"$TARGET\" in ab|split) available_gate \"$HOST_B_PATH\" \"$HOST_B_KIND\" || exit 1;; esac; mkdir -p .ai/hgt_logs || exit 1; LOGROOT=\"$A_ROOT/.ai/hgt_logs\"; g(){ p=\"$1\"; k=\"$2\"; case \"$k\" in python) (cd -- \"$p\" && uv run ruff check . && uv run ruff format --check . && uv run pyright src/ && uv run pytest -q);; rust) (cd -- \"$p\" && cargo test --quiet && cargo clippy --all-targets --quiet -- -D warnings);; new:*) (cd -- \"$p\" && ./ci/gate.sh);; *) return 1;; esac; }; exec 3>\"$LOGROOT/$SLUG.unit_a.log\" || exit 1; case \"$TARGET\" in ab|split) exec 4>\"$LOGROOT/$SLUG.unit_b.log\" || exit 1;; esac; result=pass; set -- \".ai/hgt_logs/$SLUG.unit_a.log\"; g \"$HOST_A_PATH\" \"$HOST_A_KIND\" >&3 2>&1 || result=fail; case \"$TARGET\" in ab|split) set -- \"$@\" \".ai/hgt_logs/$SLUG.unit_b.log\"; g \"$HOST_B_PATH\" \"$HOST_B_KIND\" >&4 2>&1 || result=fail;; esac; python3 -c 'import json,sys\nfrom pathlib import Path\nstage,slug,target,result,*logs=sys.argv[1:]\nPath('\"'\"'.ai/hgt_validation.json'\"'\"').write_text(json.dumps({'\"'\"'slug'\"'\"':slug,'\"'\"'target'\"'\"':target,'\"'\"'stage'\"'\"':stage,'\"'\"'result'\"'\"':result,'\"'\"'logs'\"'\"':logs},indent=2)+chr(10))\n' unit \"$SLUG\" \"$TARGET\" \"$result\" \"$@\" || exit 1; printf \"%s\" \"$result\" ); then :; else printf blocked; fi"]

    // --- deterministic gate 2: capability through the real terminal(s) (forge) ---
    ForgeValidate [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); mkdir -p .ai/hgt_logs || exit 1; LOGROOT=\"$A_ROOT/.ai/hgt_logs\"; test -f .ai/hgt_forge_check.sh || exit 1; export FORGE=\"$FORGE_TOOL\"; exec 3>\"$LOGROOT/$SLUG.forge_doctor.log\" || exit 1; exec 4>\"$LOGROOT/$SLUG.forge.log\" || exit 1; result=fail; set -- \".ai/hgt_logs/$SLUG.forge_doctor.log\"; if python3 \"$FORGE\" doctor >&3 2>&1; then set -- \"$@\" \".ai/hgt_logs/$SLUG.forge.log\"; if bash .ai/hgt_forge_check.sh >&4 2>&1; then result=pass; fi; fi; python3 -c 'import json,sys\nfrom pathlib import Path\nstage,slug,target,result,*logs=sys.argv[1:]\nPath('\"'\"'.ai/hgt_validation.json'\"'\"').write_text(json.dumps({'\"'\"'slug'\"'\"':slug,'\"'\"'target'\"'\"':target,'\"'\"'stage'\"'\"':stage,'\"'\"'result'\"'\"':result,'\"'\"'logs'\"'\"':logs},indent=2)+chr(10))\n' forge \"$SLUG\" \"$TARGET\" \"$result\" \"$@\" || exit 1; printf \"%s\" \"$result\" ); then :; else printf blocked; fi"]

    // --- diagnose a failing gate; append a concrete fix (never edits source) ---
    AnalyzeFailure [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="A validation gate failed. Read .ai/hgt_validation.json first; verify its slug/target match .ai/hgt_current.env, then read only the current stage logs listed there and .ai/hgt_impl.log. Do not use stale logs from a skipped host, prior stage or earlier capability. Diagnose the root cause and append a numbered 'Fix N' section to .ai/hgt_plan.md with concrete, minimal changes, naming the host each change lands in. Do not edit source here \u2014 Implement applies the fix. Known flake: forge screen-scrape is timing-sensitive under load; if the ONLY failure is a forge assertion, say 're-run to confirm' rather than inventing a code fix. $goal"]

    // --- bound the fix loop at 3 (own counter; orthogonal to engine default_max_retry) ---
    RetryGate [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); n=0; if test -e .ai/hgt_retries; then n=$(cat .ai/hgt_retries) || exit 1; fi; case \"$n\" in ''|*[!0-9]*) exit 1;; esac; test \"$n\" -le 3 || exit 1; if test \"$n\" -ge 3; then printf giveup; else n=$((n+1)); printf \"%s\\n\" \"$n\" > .ai/hgt_retries || exit 1; if test \"$n\" -lt 3; then printf retry; else printf giveup; fi; fi ); then :; else printf blocked; fi"]

    // --- converged: commit + PR per targeted host, mark implemented ---
    Commit [shape=parallelogram,
        tool_command="if ( selection=$(python3 -c 'import os,re,subprocess,sys\nfrom pathlib import Path\n\ndef fail(message):\n    raise ValueError(message)\ndef repo(value):\n    p=Path(value).resolve(strict=True)\n    if not p.is_dir(): fail('\"'\"'repository directory missing'\"'\"')\n    result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(p),'\"'\"'rev-parse'\"'\"','\"'\"'--show-toplevel'\"'\"'],check=True,capture_output=True,text=True)\n    if Path(result.stdout.strip()).resolve()!=p: fail('\"'\"'expected repository root'\"'\"')\n    return p\ndef safe(base,relative,kind='\"'\"'file'\"'\"',required=False):\n    value=Path(relative)\n    if value.is_absolute() or not value.parts or '\"'\"'..'\"'\"' in value.parts: fail('\"'\"'path must be contained and relative'\"'\"')\n    current=base\n    for index,part in enumerate(value.parts):\n        current=current/part\n        if current.is_symlink(): fail('\"'\"'symlinked pipeline path refused'\"'\"')\n        if current.exists() and index<len(value.parts)-1 and not current.is_dir(): fail('\"'\"'path ancestor is not a directory'\"'\"')\n    if required and not current.exists(): fail('\"'\"'required pipeline input missing'\"'\"')\n    if current.exists() and (not current.is_dir() if kind=='\"'\"'dir'\"'\"' else not current.is_file()): fail('\"'\"'wrong pipeline path type'\"'\"')\n    return current\ndef state(path):\n    values={}\n    for line in path.read_text().splitlines():\n        key,separator,value=line.partition('\"'\"'='\"'\"')\n        if not separator or key not in {'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'} or key in values or not value: fail('\"'\"'invalid or duplicate state field'\"'\"')\n        values[key]=value\n    if set(values)!={'\"'\"'SLUG'\"'\"','\"'\"'TARGET'\"'\"'}: fail('\"'\"'incomplete state'\"'\"')\n    return values['\"'\"'SLUG'\"'\"'],values['\"'\"'TARGET'\"'\"']\ntry:\n    mode=sys.argv[1]\n    primary=repo(os.environ['\"'\"'HOST_A_PATH'\"'\"'])\n    donor=repo(os.environ['\"'\"'DONOR_PATH'\"'\"'])\n    if primary==donor: fail('\"'\"'donor and host must be distinct'\"'\"')\n    forge=Path(os.environ['\"'\"'FORGE_TOOL'\"'\"'])\n    if not forge.is_file(): fail('\"'\"'Forge tool file missing'\"'\"')\n    safe(primary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    for name in ['\"'\"'hgt_current.env'\"'\"','\"'\"'hgt_current.md'\"'\"','\"'\"'hgt_retries'\"'\"','\"'\"'hgt_donor.md'\"'\"','\"'\"'hgt_plan.md'\"'\"','\"'\"'hgt_forge_check.sh'\"'\"','\"'\"'hgt_impl.log'\"'\"','\"'\"'hgt_validation.json'\"'\"','\"'\"'verify_current.env'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name)\n    for name in ['\"'\"'hgt_logs'\"'\"','\"'\"'hgt_blocked'\"'\"','\"'\"'verify_checks'\"'\"','\"'\"'verify_findings'\"'\"','\"'\"'verify_logs'\"'\"']:\n        safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'dir'\"'\"')\n    safe(primary,'\"'\"'pipelines'\"'\"','\"'\"'dir'\"'\"',True)\n    safe(primary,'\"'\"'pipelines/ledger.py'\"'\"','\"'\"'file'\"'\"',True)\n    ledger=safe(primary,os.environ['\"'\"'LEDGER_FILE'\"'\"'],'\"'\"'file'\"'\"',True)\n    rows=[];seen=set()\n    for line in ledger.read_text().splitlines():\n        if not line.strip() or line.lstrip().startswith('\"'\"'#'\"'\"'): continue\n        parts=[part.strip() for part in line.split('\"'\"'\\t'\"'\"')]\n        if len(parts)!=3: fail('\"'\"'malformed ledger row'\"'\"')\n        slug,target,stage=parts\n        if not re.fullmatch(r'\"'\"'[A-Za-z0-9._-]+'\"'\"',slug) or slug in seen: fail('\"'\"'invalid or duplicate ledger key'\"'\"')\n        if target not in {'\"'\"'a'\"'\"','\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} or stage not in {'\"'\"'new'\"'\"','\"'\"'implemented'\"'\"','\"'\"'verified'\"'\"','\"'\"'acknowledged'\"'\"'}: fail('\"'\"'invalid ledger target or state'\"'\"')\n        seen.add(slug);rows.append((slug,target,stage))\n    desired='\"'\"'implemented'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'new'\"'\"'\n    eligible=[row for row in rows if row[2]==desired]\n    if mode.endswith('\"'\"'state'\"'\"'):\n        name='\"'\"'verify_current.env'\"'\"' if mode.startswith('\"'\"'verify'\"'\"') else '\"'\"'hgt_current.env'\"'\"'\n        slug,target=state(safe(primary,'\"'\"'.ai/'\"'\"'+name,'\"'\"'file'\"'\"',True))\n        if not eligible or (slug,target)!=eligible[0][:2]: fail('\"'\"'state does not match the next eligible ledger row'\"'\"')\n    elif eligible:\n        slug,target=eligible[0][:2]\n    else:\n        print('\"'\"'NONE'\"'\"');raise SystemExit(0)\n    subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'check-ref-format'\"'\"','\"'\"'--branch'\"'\"','\"'\"'hgt/'\"'\"'+slug],check=True,capture_output=True)\n    if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'}:\n        secondary=repo(os.environ['\"'\"'HOST_B_PATH'\"'\"'])\n        if secondary in {primary,donor}: fail('\"'\"'donor and hosts must be distinct'\"'\"')\n        safe(secondary,'\"'\"'.ai'\"'\"','\"'\"'dir'\"'\"')\n    if not mode.startswith('\"'\"'verify'\"'\"'):\n        for name in ['\"'\"'HOST_A_KIND'\"'\"']+(['\"'\"'HOST_B_KIND'\"'\"'] if target in {'\"'\"'ab'\"'\"','\"'\"'split'\"'\"'} else []):\n            kind=os.environ[name]\n            if kind not in {'\"'\"'python'\"'\"','\"'\"'rust'\"'\"'} and not (kind.startswith('\"'\"'new:'\"'\"') and len(kind)>4): fail('\"'\"'invalid host kind'\"'\"')\n        retry=safe(primary,'\"'\"'.ai/hgt_retries'\"'\"')\n        if retry.exists() and (not re.fullmatch('\"'\"'[0-3]'\"'\"'+chr(10)+'\"'\"'?'\"'\"',retry.read_text())): fail('\"'\"'invalid retry counter'\"'\"')\n        for suffix in ['\"'\"'unit_a.log'\"'\"','\"'\"'unit_b.log'\"'\"','\"'\"'forge.log'\"'\"','\"'\"'forge_doctor.log'\"'\"','\"'\"'pr_a.log'\"'\"','\"'\"'pr_b.log'\"'\"']:\n            safe(primary,'\"'\"'.ai/hgt_logs/'\"'\"'+slug+'\"'\"'.'\"'\"'+suffix)\n        safe(primary,'\"'\"'.ai/hgt_blocked/'\"'\"'+slug+'\"'\"'.md'\"'\"')\n    else:\n        for relative in ['\"'\"'verify_checks/'\"'\"'+slug+'\"'\"'.sh'\"'\"','\"'\"'verify_findings/'\"'\"'+slug+'\"'\"'.md'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.doctor.log'\"'\"','\"'\"'verify_logs/'\"'\"'+slug+'\"'\"'.checks.log'\"'\"','\"'\"'verify_flake_'\"'\"'+slug,'\"'\"'verify_reopened_'\"'\"'+slug]:\n            safe(primary,'\"'\"'.ai/'\"'\"'+relative)\n    print(slug+'\"'\"' '\"'\"'+target)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'pipeline preflight blocked: '\"'\"'+str(error),file=sys.stderr)\n    raise SystemExit(1)\n' main_state) || exit 1; set -f; set -- $selection; test \"$#\" -eq 2 || exit 1; SLUG=$1; TARGET=$2; export SLUG TARGET; cd -- \"$HOST_A_PATH\" || exit 1; A_ROOT=$(pwd -P); test \"$(git branch --show-current)\" = \"hgt/$SLUG\" || exit 1; case \"$TARGET\" in ab|split) test \"$(git -C \"$HOST_B_PATH\" branch --show-current)\" = \"hgt/$SLUG\" || exit 1;; esac; case \"$TARGET\" in ab|split) python3 -c 'import os,subprocess,sys\nfrom pathlib import Path,PurePosixPath\ntry:\n    for root in sys.argv[1:]:\n        result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',root,'\"'\"'diff'\"'\"','\"'\"'--cached'\"'\"','\"'\"'--no-renames'\"'\"','\"'\"'--name-only'\"'\"','\"'\"'-z'\"'\"'],check=True,capture_output=True)\n        for name in result.stdout.split(b'\"'\"'\\0'\"'\"'):\n            if not name: continue\n            parts=PurePosixPath(os.fsdecode(name)).parts\n            controls={PurePosixPath(os.environ['\"'\"'LEDGER_FILE'\"'\"']).as_posix(),'\"'\"'pipelines/ledger.py'\"'\"'} if Path(root).resolve()==Path(os.environ['\"'\"'HOST_A_PATH'\"'\"']).resolve() else set()\n            if PurePosixPath(os.fsdecode(name)).as_posix() in controls or any(part in {'\"'\"'.ai'\"'\"','\"'\"'__pycache__'\"'\"'} or part.endswith('\"'\"'.pyc'\"'\"') for part in parts):\n                print('\"'\"'staged metadata or control files refused; index preserved'\"'\"',file=sys.stderr)\n                raise SystemExit(1)\nexcept (OSError,subprocess.SubprocessError):\n    raise SystemExit(1)\n' \"$HOST_A_PATH\" \"$HOST_B_PATH\" || exit 1;; *) python3 -c 'import os,subprocess,sys\nfrom pathlib import Path,PurePosixPath\ntry:\n    for root in sys.argv[1:]:\n        result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',root,'\"'\"'diff'\"'\"','\"'\"'--cached'\"'\"','\"'\"'--no-renames'\"'\"','\"'\"'--name-only'\"'\"','\"'\"'-z'\"'\"'],check=True,capture_output=True)\n        for name in result.stdout.split(b'\"'\"'\\0'\"'\"'):\n            if not name: continue\n            parts=PurePosixPath(os.fsdecode(name)).parts\n            controls={PurePosixPath(os.environ['\"'\"'LEDGER_FILE'\"'\"']).as_posix(),'\"'\"'pipelines/ledger.py'\"'\"'} if Path(root).resolve()==Path(os.environ['\"'\"'HOST_A_PATH'\"'\"']).resolve() else set()\n            if PurePosixPath(os.fsdecode(name)).as_posix() in controls or any(part in {'\"'\"'.ai'\"'\"','\"'\"'__pycache__'\"'\"'} or part.endswith('\"'\"'.pyc'\"'\"') for part in parts):\n                print('\"'\"'staged metadata or control files refused; index preserved'\"'\"',file=sys.stderr)\n                raise SystemExit(1)\nexcept (OSError,subprocess.SubprocessError):\n    raise SystemExit(1)\n' \"$HOST_A_PATH\" || exit 1;; esac; mkdir -p .ai/hgt_logs || exit 1; LOGROOT=\"$A_ROOT/.ai/hgt_logs\"; exec 3>\"$LOGROOT/$SLUG.pr_a.log\" || exit 1; case \"$TARGET\" in ab|split) exec 4>\"$LOGROOT/$SLUG.pr_b.log\" || exit 1;; esac; stage_host(){ python3 -c 'import os,subprocess,sys\nfrom pathlib import Path,PurePosixPath\ntry:\n    operation=sys.argv[1]\n    if operation not in {'\"'\"'add'\"'\"','\"'\"'stash'\"'\"'}: raise ValueError('\"'\"'unknown Git operation'\"'\"')\n    root=Path(sys.argv[2]).resolve(strict=True)\n    primary=Path(os.environ['\"'\"'HOST_A_PATH'\"'\"']).resolve(strict=True)\n    controls={PurePosixPath(os.environ['\"'\"'LEDGER_FILE'\"'\"']).as_posix(),'\"'\"'pipelines/ledger.py'\"'\"'} if root==primary else set()\n    base=['\"'\"'git'\"'\"','\"'\"'--literal-pathspecs'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',str(root)]\n    inventory=subprocess.run(base+['\"'\"'ls-files'\"'\"','\"'\"'-z'\"'\"','\"'\"'--cached'\"'\"','\"'\"'--others'\"'\"','\"'\"'--exclude-standard'\"'\"'],check=True,capture_output=True).stdout\n    selected=[]\n    for raw in sorted(set(inventory.split(b'\"'\"'\\0'\"'\"'))):\n        if not raw: continue\n        relative=PurePosixPath(os.fsdecode(raw))\n        if relative.as_posix() in controls: continue\n        if any(part in {'\"'\"'.ai'\"'\"','\"'\"'__pycache__'\"'\"'} or part.endswith('\"'\"'.pyc'\"'\"') for part in relative.parts): continue\n        selected.append(raw)\n    if not selected: raise SystemExit(0)\n    payload=b'\"'\"'\\0'\"'\"'.join(selected)+b'\"'\"'\\0'\"'\"'\n    arguments=['\"'\"'add'\"'\"','\"'\"'-A'\"'\"'] if operation=='\"'\"'add'\"'\"' else ['\"'\"'stash'\"'\"','\"'\"'push'\"'\"','\"'\"'-q'\"'\"','\"'\"'--include-untracked'\"'\"']\n    subprocess.run(base+arguments+['\"'\"'--pathspec-from-file=-'\"'\"','\"'\"'--pathspec-file-nul'\"'\"'],input=payload,check=True,capture_output=True)\nexcept (OSError,ValueError,KeyError,subprocess.SubprocessError) as error:\n    print('\"'\"'controlled Git operation blocked'\"'\"',file=sys.stderr)\n    details=getattr(error,'\"'\"'stderr'\"'\"',b'\"'\"''\"'\"')\n    if details: sys.stderr.buffer.write(details)\n    raise SystemExit(1)\n' add \"$1\"; }; commit_host(){ cd -- \"$1\" || exit 1; stage_host \"$1\" || exit 1; python3 -c 'import os,subprocess,sys\nfrom pathlib import Path,PurePosixPath\ntry:\n    for root in sys.argv[1:]:\n        result=subprocess.run(['\"'\"'git'\"'\"','\"'\"'-c'\"'\"','\"'\"'core.fsmonitor=false'\"'\"','\"'\"'-C'\"'\"',root,'\"'\"'diff'\"'\"','\"'\"'--cached'\"'\"','\"'\"'--no-renames'\"'\"','\"'\"'--name-only'\"'\"','\"'\"'-z'\"'\"'],check=True,capture_output=True)\n        for name in result.stdout.split(b'\"'\"'\\0'\"'\"'):\n            if not name: continue\n            parts=PurePosixPath(os.fsdecode(name)).parts\n            controls={PurePosixPath(os.environ['\"'\"'LEDGER_FILE'\"'\"']).as_posix(),'\"'\"'pipelines/ledger.py'\"'\"'} if Path(root).resolve()==Path(os.environ['\"'\"'HOST_A_PATH'\"'\"']).resolve() else set()\n            if PurePosixPath(os.fsdecode(name)).as_posix() in controls or any(part in {'\"'\"'.ai'\"'\"','\"'\"'__pycache__'\"'\"'} or part.endswith('\"'\"'.pyc'\"'\"') for part in parts):\n                print('\"'\"'staged metadata or control files refused; index preserved'\"'\"',file=sys.stderr)\n                raise SystemExit(1)\nexcept (OSError,subprocess.SubprocessError):\n    raise SystemExit(1)\n' \"$1\" || exit 1; git commit -q -m \"feat(hgt): $SLUG\" || exit 1; git push -q -u origin HEAD || exit 1; gh pr create --fill --base main --head \"hgt/$SLUG\" --label hgt >&\"$2\" 2>&1 || exit 1; }; commit_host \"$HOST_A_PATH\" 3; case \"$TARGET\" in ab|split) commit_host \"$HOST_B_PATH\" 4;; esac; cd -- \"$A_ROOT\" || exit 1; LEDGER_FILE=\"$LEDGER_FILE\" python3 pipelines/ledger.py update \"$SLUG\" implemented >/dev/null || exit 1; printf next ); then :; else printf blocked; fi"]

