// HGT — the Horizontal Gene-Transfer attractor (archetype graph).
//
// Transfers ONE capability per loop from a donor repo (any language) into one or
// two host repos, RE-EXPRESSED through each host's own seams — never a code graft.
// Gated by the host's unit suite AND a real-terminal forge check before a PR opens.
//
// ENGINE: attractor loop-pipeline. `box` = LLM agent; `parallelogram` = deterministic
// tool node routed on its LAST printed stdout line (context.tool.last_line, matched
// by EXACT string equality; stderr ignored; non-zero exit leaves last_line STALE —
// which is why every gate ends `... && printf pass || printf fail`, never remove it).
//
// PARAMETERS reach tool nodes as UPPERCASE SHELL ENV VARS (fail-loud). Export them
// before launch, OR pass identically-named params via run_pipeline (which seeds them
// as flat context keys). Do NOT rely on a mounted orchestrator's `config.params` for
// tool_command substitution — that path reaches prompts only, not tool_command
// (engine limitation; see docs/DESIGN_DECISIONS.md).
//   DONOR_PATH     abs path to the donor repo (READ-ONLY)
//   HOST_A_PATH    abs path to host A (the primary/backend host)
//   HOST_A_KIND    python | rust | new:<lang>   (selects host A's gate stack)
//   HOST_B_PATH    abs path to host B (only for TARGET in {ab,split})
//   HOST_B_KIND    python | rust | new:<lang>
//   FORGE_TOOL     abs path to amplifier-skill-forge/tools/forge.py
//   LEDGER_FILE    ledger path relative to HOST_A_PATH (e.g. pipelines/hgt-ledger.tsv)
//   SCOPE          free-text scope statement (what transfers; exclusions)
//
// LEDGER row = <slug>\t<target>\t<state>. target in {a, ab, split}:
//   a     — host A only (a second host, if any, gets it free over A's protocol)
//   ab    — pure client-side capability: BOTH hosts, each with its own tests/goldens
//   split — host-A backend/protocol FIRST, then client in both (seed as two ordered
//           rows: <slug>-backend (a), then <slug>-client (ab))
// state in {new, implemented, acknowledged}. Keyed by capability SLUG.
//
// MODELS: claude-opus-4-8 on every LLM node (fable-5 refuses autonomous porting).

digraph hgt {
    graph [
        goal="Re-express each capability in the ledger through the host's OWN seams. NEVER import, vendor, or copy donor source (document the behavioral contract; the donor may be any language). Obey each host's conventions and layering. Gate every transfer on the host unit suite AND a real-terminal forge check. One ledger row per loop; one PR per host; never commit to a protected branch. Done when no 'new' rows remain.",
        default_fidelity="truncate",
        default_max_retry="3"
    ]

    start [shape=Mdiamond]

    // --- loop head: params present? any work left? (deterministic, fail-loud) ---
    CheckLedger [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; : \"${DONOR_PATH:?set DONOR_PATH}\" \"${HOST_A_KIND:?set HOST_A_KIND}\" \"${FORGE_TOOL:?set FORGE_TOOL}\" \"${LEDGER_FILE:?set LEDGER_FILE}\" || exit 1; next=$(python3 pipelines/ledger.py earliest) || exit 1; if test \"$next\" = NONE; then printf done; else printf process; fi ); then :; else printf blocked; fi"]

    // --- pick the earliest 'new' capability; capture slug + target ---
    SelectCapability [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="In $HOST_A_PATH run `LEDGER_FILE=$LEDGER_FILE python3 pipelines/ledger.py earliest` \u2014 it prints '<slug> <target>'. Read the capability's one-line summary and donor pointer for <slug> from the run's capability spec (the ledger's companion doc, e.g. pipelines/*-capabilities.md). Scope for this run: $SCOPE. Write TWO files under $HOST_A_PATH/.ai/: (1) hgt_current.md \u2014 slug, target, a one-paragraph capability summary, the donor pointer VERBATIM; (2) hgt_current.env \u2014 exactly two lines `SLUG=<slug>` and `TARGET=<target>`. Delete .ai/hgt_retries if present. $goal"]

    // --- fresh per-capability branch in each targeted host (deterministic) ---
    BranchSetup [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; SLUG=; TARGET=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in SLUG=*) test -z \"$SLUG\" || die 'duplicate SLUG'; SLUG=${line#SLUG=};; TARGET=*) test -z \"$TARGET\" || die 'duplicate TARGET'; TARGET=${line#TARGET=};; *) die 'invalid transfer state';; esac; done < .ai/hgt_current.env || exit 1; case \"$SLUG\" in ''|*[!A-Za-z0-9._-]*) die 'invalid SLUG';; esac; case \"$TARGET\" in a|ab|split) :;; *) die 'invalid TARGET';; esac; git check-ref-format --branch \"hgt/$SLUG\" >/dev/null || exit 1; export SLUG TARGET; case \"$TARGET\" in ab|split) root \"${HOST_B_PATH:?set HOST_B_PATH}\"; test \"$(pwd -P)\" != \"$(cd -- \"$HOST_B_PATH\" && pwd -P)\" || die 'hosts must be distinct';; esac; if git show-ref --verify --quiet \"refs/heads/hgt/$SLUG\"; then die 'run branch already exists'; fi; case \"$TARGET\" in ab|split) if git -C \"$HOST_B_PATH\" show-ref --verify --quiet \"refs/heads/hgt/$SLUG\"; then die 'second run branch already exists'; fi;; esac; git stash -q --include-untracked -- ':(exclude).ai' || exit 1; git checkout -q main || exit 1; git pull -q --ff-only || exit 1; git checkout -q -b \"hgt/$SLUG\" || exit 1; case \"$TARGET\" in ab|split) cd -- \"$HOST_B_PATH\" || exit 1; git stash -q --include-untracked -- ':(exclude).ai' || exit 1; git checkout -q main || exit 1; git pull -q --ff-only || exit 1; git checkout -q -b \"hgt/$SLUG\" || exit 1;; esac; cd -- \"$HOST_A_PATH\" || exit 1; rm -f .ai/hgt_retries || exit 1 ); then printf ready; else printf blocked; fi"]

    // --- study the donor WITHOUT copying (behavioral contract only; observe via forge) ---
    LocateDonor [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read $HOST_A_PATH/.ai/hgt_current.md. In the donor at $DONOR_PATH, locate the construct(s) implementing this capability (start from the donor pointer). Record the BEHAVIORAL CONTRACT ONLY \u2014 inputs, outputs, config keys, protocol/wire shape, edge cases, user-facing UX \u2014 in $HOST_A_PATH/.ai/hgt_donor.md. Do NOT copy source; you are documenting the gene, not grafting the organ. State explicitly which parts are backend logic vs pure client render (this decides what lands in host A vs a client). Where UX matters and forge can drive the donor, boot it via $FORGE_TOOL to observe the real behavior live. $goal"]

    // --- design the re-expression per target + author the forge probe FIRST ---
    PlanTransfer [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read .ai/hgt_current.md, .ai/hgt_donor.md, .ai/hgt_current.env (TARGET), and each targeted host's conventions (host A: its AGENTS.md / architecture / decision docs; host B if TARGET in {ab,split}: its migration/parity docs). Design how to re-express this capability through each host's OWN seams \u2014 never importing the donor. Name the exact files to change per host, the native primitives to reuse, and every test/golden to add. For 'split': the host-A backend + any protocol addition FIRST, then the client render. Write the plan to .ai/hgt_plan.md. THEN \u2014 acceptance-first \u2014 author the forge probe to .ai/hgt_forge_check.sh: a bash script using $FORGE_TOOL (env $FORGE) that boots the REAL host-A app and, for TARGET in {ab,split}, the REAL host-B app, and asserts the capability from screen/grep; exit 0 on success, non-zero otherwise. Derive assertions from the donor's user-facing contract \u2014 the probe is the spec. $goal"]

    // --- implement the VERTICAL SLICE (feature + tests + CI parity together) ---
    Implement [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read .ai/hgt_plan.md (including any appended 'Fix N' sections) and .ai/hgt_current.env for TARGET. Implement the VERTICAL SLICE in one pass \u2014 feature + unit tests + forge probe + CI parity together, never build-now-test-later \u2014 with file tools on the current branch(es): host-A changes in $HOST_A_PATH (obey its layering; client-visible behavior through its protocol; pure renderers golden-tested), host-B changes in $HOST_B_PATH when TARGET in {ab,split} (idiomatic client, behavioral-equivalence tests, never force-green). The local gate MUST equal what the host's CI runs. Regenerate goldens if a pure renderer changed. Do NOT run the suites yourself \u2014 the next node does. Append files changed (per host) to .ai/hgt_impl.log. $goal"]

    // --- deterministic gate 1: host unit suites, dispatched by kind (== CI) ---
    UnitValidate [shape=parallelogram,
        tool_command="( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; SLUG=; TARGET=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in SLUG=*) test -z \"$SLUG\" || die 'duplicate SLUG'; SLUG=${line#SLUG=};; TARGET=*) test -z \"$TARGET\" || die 'duplicate TARGET'; TARGET=${line#TARGET=};; *) die 'invalid transfer state';; esac; done < .ai/hgt_current.env || exit 1; case \"$SLUG\" in ''|*[!A-Za-z0-9._-]*) die 'invalid SLUG';; esac; case \"$TARGET\" in a|ab|split) :;; *) die 'invalid TARGET';; esac; git check-ref-format --branch \"hgt/$SLUG\" >/dev/null || exit 1; export SLUG TARGET; case \"$TARGET\" in ab|split) root \"${HOST_B_PATH:?set HOST_B_PATH}\"; test \"$(pwd -P)\" != \"$(cd -- \"$HOST_B_PATH\" && pwd -P)\" || die 'hosts must be distinct';; esac; g(){ p=\"$1\"; k=\"$2\"; case \"$k\" in python) ( cd -- \"$p\" && uv run ruff check . && uv run ruff format --check . && uv run pyright src/ && uv run pytest -q );; rust) ( cd -- \"$p\" && cargo test --quiet && cargo clippy --all-targets --quiet -- -D warnings );; new:*) ( cd -- \"$p\" && ./ci/gate.sh );; *) echo \"unknown kind $k\" >&2; return 1;; esac; }; ok=1; g \"$HOST_A_PATH\" \"$HOST_A_KIND\" >/tmp/hgt_gate_a 2>&1 || ok=0; case \"$TARGET\" in ab|split) g \"$HOST_B_PATH\" \"$HOST_B_KIND\" >/tmp/hgt_gate_b 2>&1 || ok=0;; esac; test \"$ok\" = 1 ) && printf pass || printf fail"]

    // --- deterministic gate 2: capability through the real terminal(s) (forge) ---
    ForgeValidate [shape=parallelogram,
        tool_command="( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; export FORGE=\"${FORGE_TOOL:?set FORGE_TOOL}\"; python3 \"$FORGE\" doctor >/tmp/hgt_forge_doctor 2>&1 && bash .ai/hgt_forge_check.sh >/tmp/hgt_forge 2>&1 ) && printf pass || printf fail"]

    // --- diagnose a failing gate; append a concrete fix (never edits source) ---
    AnalyzeFailure [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="A validation gate failed. Read /tmp/hgt_gate_a, /tmp/hgt_gate_b, /tmp/hgt_forge, /tmp/hgt_forge_doctor and .ai/hgt_impl.log. Diagnose the root cause and append a numbered 'Fix N' section to .ai/hgt_plan.md with concrete, minimal changes, naming the host each change lands in. Do not edit source here \u2014 Implement applies the fix. Known flake: forge screen-scrape is timing-sensitive under load; if the ONLY failure is a forge assertion, say 're-run to confirm' rather than inventing a code fix. $goal"]

    // --- bound the fix loop at 3 (own counter; orthogonal to engine default_max_retry) ---
    RetryGate [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; n=0; if test -e .ai/hgt_retries; then n=$(cat .ai/hgt_retries) || exit 1; fi; case \"$n\" in ''|*[!0-9]*) die 'invalid retry count';; esac; test \"$n\" -le 3 || die 'invalid retry count'; n=$((n+1)); printf '%s\\n' \"$n\" > .ai/hgt_retries || exit 1; if test \"$n\" -le 3; then printf retry; else printf giveup; fi ); then :; else printf blocked; fi"]

    // --- converged: commit + PR per targeted host, mark implemented ---
    Commit [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; SLUG=; TARGET=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in SLUG=*) test -z \"$SLUG\" || die 'duplicate SLUG'; SLUG=${line#SLUG=};; TARGET=*) test -z \"$TARGET\" || die 'duplicate TARGET'; TARGET=${line#TARGET=};; *) die 'invalid transfer state';; esac; done < .ai/hgt_current.env || exit 1; case \"$SLUG\" in ''|*[!A-Za-z0-9._-]*) die 'invalid SLUG';; esac; case \"$TARGET\" in a|ab|split) :;; *) die 'invalid TARGET';; esac; git check-ref-format --branch \"hgt/$SLUG\" >/dev/null || exit 1; export SLUG TARGET; case \"$TARGET\" in ab|split) root \"${HOST_B_PATH:?set HOST_B_PATH}\"; test \"$(pwd -P)\" != \"$(cd -- \"$HOST_B_PATH\" && pwd -P)\" || die 'hosts must be distinct';; esac; test \"$(git branch --show-current)\" = \"hgt/$SLUG\" || die 'wrong run branch'; commit_host(){ cd -- \"$1\" || exit 1; git add -A -- ':(exclude).ai' ':(exclude)*.pyc' ':(exclude)__pycache__' || exit 1; git commit -q -m \"feat(hgt): $SLUG\" || exit 1; git push -q -u origin HEAD || exit 1; gh pr create --fill --base main --head \"hgt/$SLUG\" --label hgt > \"$2\" 2>&1 || exit 1; }; case \"$TARGET\" in ab|split) test \"$(git -C \"$HOST_B_PATH\" branch --show-current)\" = \"hgt/$SLUG\" || die 'wrong second run branch';; esac; commit_host \"$HOST_A_PATH\" /tmp/hgt_pr_a; case \"$TARGET\" in ab|split) commit_host \"$HOST_B_PATH\" /tmp/hgt_pr_b;; esac; cd -- \"$HOST_A_PATH\" || exit 1; python3 pipelines/ledger.py update \"$SLUG\" implemented >/dev/null || exit 1 ); then printf next; else printf blocked; fi"]

    // --- could not converge: hand back to a human, keep the queue moving ---
    MarkBlocked [shape=parallelogram,
        tool_command="if ( die(){ printf '%s\\n' \"$*\" >&2; exit 1; }; root(){ test -d \"$1\" || die 'target directory missing'; (cd -- \"$1\" && test \"$(git rev-parse --show-toplevel)\" = \"$(pwd -P)\") || die 'target must be the repository root'; }; root \"${HOST_A_PATH:?set HOST_A_PATH}\"; cd -- \"$HOST_A_PATH\" || exit 1; SLUG=; TARGET=; while IFS= read -r line || test -n \"$line\"; do case \"$line\" in SLUG=*) test -z \"$SLUG\" || die 'duplicate SLUG'; SLUG=${line#SLUG=};; TARGET=*) test -z \"$TARGET\" || die 'duplicate TARGET'; TARGET=${line#TARGET=};; *) die 'invalid transfer state';; esac; done < .ai/hgt_current.env || exit 1; case \"$SLUG\" in ''|*[!A-Za-z0-9._-]*) die 'invalid SLUG';; esac; case \"$TARGET\" in a|ab|split) :;; *) die 'invalid TARGET';; esac; git check-ref-format --branch \"hgt/$SLUG\" >/dev/null || exit 1; export SLUG TARGET; case \"$TARGET\" in ab|split) root \"${HOST_B_PATH:?set HOST_B_PATH}\"; test \"$(pwd -P)\" != \"$(cd -- \"$HOST_B_PATH\" && pwd -P)\" || die 'hosts must be distinct';; esac; mkdir -p .ai/hgt_blocked || exit 1; cp .ai/hgt_plan.md \".ai/hgt_blocked/$SLUG.md\" || exit 1; python3 pipelines/ledger.py update \"$SLUG\" acknowledged >/dev/null || exit 1; git checkout -q main || exit 1; case \"$TARGET\" in ab|split) cd -- \"$HOST_B_PATH\" || exit 1; git checkout -q main || exit 1;; esac ); then printf next; else printf blocked; fi"]

    CheckLedger -> exit [condition="context.tool.last_line=blocked"]

    RetryGate -> exit [condition="context.tool.last_line=blocked"]

    Commit -> exit [condition="context.tool.last_line=blocked"]

    MarkBlocked -> exit [condition="context.tool.last_line=blocked"]

    exit [shape=Msquare]

    // --- flow ---
    start -> CheckLedger
    CheckLedger -> exit             [condition="context.tool.last_line=done"]
    CheckLedger -> SelectCapability [condition="context.tool.last_line=process"]

    SelectCapability -> BranchSetup
    BranchSetup -> LocateDonor [condition="context.tool.last_line=ready"]
    BranchSetup -> exit [condition="context.tool.last_line=blocked"]
    LocateDonor -> PlanTransfer
    PlanTransfer -> Implement
    Implement -> UnitValidate

    UnitValidate  -> ForgeValidate  [condition="context.tool.last_line=pass"]
    UnitValidate  -> AnalyzeFailure [condition="context.tool.last_line=fail"]
    ForgeValidate -> Commit         [condition="context.tool.last_line=pass"]
    ForgeValidate -> AnalyzeFailure [condition="context.tool.last_line=fail"]

    AnalyzeFailure -> RetryGate
    RetryGate -> Implement   [condition="context.tool.last_line=retry"]
    RetryGate -> MarkBlocked [condition="context.tool.last_line=giveup"]

    Commit      -> CheckLedger [condition="context.tool.last_line=next", loop_restart="true"]
    MarkBlocked -> CheckLedger [condition="context.tool.last_line=next", loop_restart="true"]
}
